{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Registered student account, school credentials, and streak telemetry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "classLevel": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolBoard": { "type": "string" },
        "schoolCity": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "rollNumber": { "type": "string" },
        "streakDays": { "type": "number" },
        "totalXP": { "type": "number" },
        "joinedDate": { "type": "string" },
        "authProvider": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "classLevel"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Completed test scorecards, subject breakdowns, and topic mastery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentEmail": { "type": "string" },
        "testTitle": { "type": "string" },
        "classLevel": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "date": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "skippedCount": { "type": "number" },
        "strongTopics": {
          "type": "array"
        },
        "topicsToPractise": {
          "type": "array"
        }
      },
      "required": ["id", "studentEmail", "testTitle", "subject", "score"]
    },
    "ParentSession": {
      "title": "ParentSession",
      "description": "Parental login session, relationship, and linked student child account.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "relationship": { "type": "string" },
        "linkedStudentEmail": { "type": "string" },
        "loginDate": { "type": "string" }
      },
      "required": ["id", "parentName", "email", "linkedStudentEmail"]
    },
    "StudyScheduleEvent": {
      "title": "StudyScheduleEvent",
      "description": "Smart AI-suggested or student-created study event calendar entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentEmail": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "eventCategory": { "type": "string" },
        "aiOptimizationRationale": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentEmail", "title", "subject", "date"]
    },
    "StudyChatMessage": {
      "title": "StudyChatMessage",
      "description": "Real-time collaborative chat message with code, LaTeX formulas, and image attachments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderClass": { "type": "string" },
        "senderRole": { "type": "string" },
        "messageType": { "type": "string" },
        "text": { "type": "string" },
        "codeSnippet": { "type": "string" },
        "codeLanguage": { "type": "string" },
        "latexFormula": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "roomId", "senderName", "text"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "StudentProfile",
      "description": "Collection of student accounts and profiles."
    },
    "/quizResults/{resultId}": {
      "schema": "QuizResult",
      "description": "Collection of test scorecards and quiz history."
    },
    "/parentSessions/{parentSessionId}": {
      "schema": "ParentSession",
      "description": "Collection of parental oversight sessions."
    },
    "/studyScheduleEvents/{eventId}": {
      "schema": "StudyScheduleEvent",
      "description": "Collection of AI-suggested and personalized calendar study events."
    },
    "/studyChatMessages/{messageId}": {
      "schema": "StudyChatMessage",
      "description": "Collection of real-time study room chat messages."
    }
  }
}
